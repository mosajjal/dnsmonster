---
import {
	Activity,
	Boxes,
	Filter,
	Gauge,
	Layers,
	Lock,
	Network,
	Package,
	Radio,
	ShieldCheck,
	Split,
	Terminal,
} from 'lucide-react';

const icons = {
	activity: Activity,
	boxes: Boxes,
	filter: Filter,
	gauge: Gauge,
	layers: Layers,
	lock: Lock,
	network: Network,
	package: Package,
	radio: Radio,
	shield: ShieldCheck,
	split: Split,
	terminal: Terminal,
} as const;

interface Props {
	items: { icon: keyof typeof icons; title: string; body: string }[];
	columns?: 2 | 3;
}

const { items, columns = 2 } = Astro.props;
---

<div class="not-content fk-features" data-columns={columns}>
	{
		items.map((item) => {
			const Icon = icons[item.icon] ?? icons.boxes;
			return (
				<article class="fk-feature">
					<span class="fk-feature__icon">
						<Icon size={18} strokeWidth={1.75} aria-hidden="true" />
					</span>
					<h3 class="fk-feature__title">{item.title}</h3>
					<p class="fk-feature__body" set:html={item.body} />
				</article>
			);
		})
	}
</div>

<style>
	.fk-features {
		display: grid;
		gap: 0.9rem;
		margin: 1.75rem 0 2.25rem;
	}

	.fk-features[data-columns='2'] {
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
	}

	.fk-features[data-columns='3'] {
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
	}

	.fk-feature {
		position: relative;
		border: 1px solid var(--fk-border-subtle);
		border-radius: 0.8rem;
		background: var(--fk-surface);
		padding: 1.15rem 1.2rem 1.25rem;
		transition:
			border-color 0.18s ease,
			transform 0.18s ease;
	}

	.fk-feature:hover {
		border-color: color-mix(in oklab, var(--fk-amber) 55%, var(--fk-border));
		transform: translateY(-1px);
	}

	.fk-feature__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.55rem;
		background: color-mix(in oklab, var(--fk-amber) 14%, transparent);
		color: var(--fk-amber);
		border: 1px solid color-mix(in oklab, var(--fk-amber) 28%, transparent);
	}

	.fk-feature__title {
		margin: 0.85rem 0 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.012em;
		color: var(--sl-color-white);
		border: 0;
		padding: 0;
	}

	.fk-feature__body {
		margin: 0.35rem 0 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--fk-text-muted);
	}

	.fk-feature__body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		color: var(--sl-color-gray-1);
		background: color-mix(in oklab, var(--sl-color-bg) 60%, transparent);
		border: 1px solid var(--fk-border-subtle);
		border-radius: 0.3rem;
		padding: 0.05em 0.3em;
	}
</style>
