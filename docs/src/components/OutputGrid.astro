---
import { ArrowUpRight } from 'lucide-react';

interface Props {
	items: { name: string; href: string; note: string }[];
}

const { items } = Astro.props;
---

<div class="not-content fk-outputs">
	{
		items.map((item) => (
			<a class="fk-output" href={item.href}>
				<span class="fk-output__name">
					{item.name}
					<ArrowUpRight size={14} strokeWidth={2} aria-hidden="true" />
				</span>
				<span class="fk-output__note">{item.note}</span>
			</a>
		))
	}
</div>

<style>
	.fk-outputs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 0.6rem;
		margin: 1.5rem 0 2rem;
	}

	.fk-output {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid var(--fk-border-subtle);
		border-radius: 0.65rem;
		background: var(--fk-surface);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.fk-output:hover {
		border-color: color-mix(in oklab, var(--fk-amber) 60%, var(--fk-border));
		background: color-mix(in oklab, var(--fk-amber) 7%, var(--fk-surface));
	}

	.fk-output__name {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-weight: 600;
		font-size: 0.925rem;
		color: var(--sl-color-white);
	}

	.fk-output__name :global(svg) {
		opacity: 0.45;
		transition: opacity 0.15s ease;
	}

	.fk-output:hover .fk-output__name :global(svg) {
		opacity: 1;
		color: var(--fk-amber);
	}

	.fk-output__note {
		font-size: 0.8rem;
		color: var(--fk-text-muted);
	}
</style>
