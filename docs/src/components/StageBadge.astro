---
interface Props {
	/** Where in the pipeline this filter is applied. */
	stage: 'kernel' | 'capture' | 'early process' | 'process' | 'output';
}

const { stage } = Astro.props;

const order = ['kernel', 'capture', 'early process', 'process', 'output'] as const;
const index = order.indexOf(stage);
---

<p class="not-content fk-stage" data-stage={stage}>
	<span class="fk-stage__pips" aria-hidden="true">
		{order.map((_, i) => <span class="fk-stage__pip" data-on={i <= index} />)}
	</span>
	<span class="fk-stage__text">Applied at <strong>{stage}</strong> level</span>
</p>

<style>
	.fk-stage {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 1rem;
		padding: 0.3rem 0.7rem 0.3rem 0.55rem;
		border: 1px solid color-mix(in oklab, var(--fk-amber) 30%, transparent);
		border-radius: 999px;
		background: color-mix(in oklab, var(--fk-amber) 9%, transparent);
	}

	.fk-stage__pips {
		display: inline-flex;
		gap: 0.18rem;
	}

	.fk-stage__pip {
		width: 0.3rem;
		height: 0.7rem;
		border-radius: 1px;
		background: color-mix(in oklab, var(--fk-amber) 22%, transparent);
	}

	.fk-stage__pip[data-on='true'] {
		background: var(--fk-amber);
	}

	.fk-stage__text {
		font-size: 0.78rem;
		letter-spacing: 0.01em;
		color: var(--fk-text-muted);
	}

	.fk-stage__text strong {
		color: var(--sl-color-white);
		font-weight: 600;
	}
</style>
