---
interface Props {
	stats: { value: string; label: string }[];
}

const { stats } = Astro.props;
---

<dl class="not-content fk-stats">
	{
		stats.map((stat) => (
			<div class="fk-stats__item">
				<dt class="fk-stats__value">{stat.value}</dt>
				<dd class="fk-stats__label">{stat.label}</dd>
			</div>
		))
	}
</dl>

<style>
	.fk-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1px;
		margin: 2rem 0;
		border: 1px solid var(--fk-border-subtle);
		border-radius: 0.8rem;
		background: var(--fk-border-subtle);
		overflow: hidden;
	}

	.fk-stats__item {
		background: var(--sl-color-bg);
		padding: 1.1rem 1.15rem;
	}

	.fk-stats__value {
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}

	.fk-stats__label {
		margin: 0.25rem 0 0;
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--fk-text-muted);
	}
</style>
